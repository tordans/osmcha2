{
  "name": "osmcha2",
  "version": "2.0.0-alpha.1",
  "bugs": {
    "url": "https://github.com/tordans/osmcha2/issues"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/tordans/osmcha2.git"
  },
  "type": "module",
  "scripts": {
    "type-check": "tsc --noEmit",
    "lint": "oxlint --fix --fix-dangerously --deny-warnings -c oxlint.config.mjs .",
    "lint-check": "oxlint --deny-warnings -c oxlint.config.mjs .",
    "format": "oxfmt --write -c oxfmt.config.mjs .",
    "format-check": "oxfmt --check -c oxfmt.config.mjs .",
    "test-run": "vitest run --passWithNoTests",
    "test-watch": "vitest",
    "coverage": "vitest run --coverage",
    "knip": "KNIP_STRICT=1 knip --config knip.config.mjs",
    "knip-warn": "knip --config knip.config.mjs || true",
    "check": "bun run --parallel type-check lint format test-run knip-warn",
    "check-ci": "bun run --parallel type-check lint-check format-check test-run",
    "check-pre-push": "bun run --parallel type-check lint format test-run knip",
    "prepare": "husky",
    "dev": "vite",
    "build": "vite build",
    "analyze": "ANALYZE=true bun run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@fontsource/open-sans": "^5.3.0",
    "@headlessui/react": "^2.2.10",
    "@osm-editor-kit/maplibre-editor-layer-index": "^0.1.7",
    "@osmcha/maplibre-adiff-viewer": "^1.3.1",
    "@osmcha/osm-adiff-parser": "^3.0.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/query-async-storage-persister": "^5.101.4",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-hotkeys": "0.10.0",
    "@tanstack/react-pacer": "^0.23.0",
    "@tanstack/react-query": "^5.90.17",
    "@tanstack/react-query-devtools": "^5.91.2",
    "@tanstack/react-query-persist-client": "^5.101.4",
    "@tanstack/react-router": "^1.170.27",
    "@tanstack/react-table": "^9.1.2",
    "@turf/area": "^7.1.0",
    "@turf/bbox": "^7.1.0",
    "@turf/bbox-polygon": "^7.2.0",
    "@turf/simplify": "^7.1.0",
    "clsx": "^2.1.1",
    "date-fns": "^4",
    "idb-keyval": "^6.3.0",
    "linkify-plugin-mention": "^4.3.3",
    "linkify-react": "^4.3.3",
    "linkifyjs": "^4.3.3",
    "maplibre-gl": "^5.1.0",
    "motion": "^13.1.0",
    "osm-auth": "^3.2.0",
    "react": "^19",
    "react-dom": "^19",
    "react-map-gl": "^8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tag2link": "^2025.5.21",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "terra-draw": "^1.1.0",
    "terra-draw-maplibre-gl-adapter": "^1.0.1",
    "zod": "4.4.3",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "^0.8.3",
    "@tanstack/react-devtools": "^0.10.10",
    "@tanstack/react-form-devtools": "^0.2.34",
    "@tanstack/react-hotkeys-devtools": "0.7.0",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/router-plugin": "^1.168.30",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.0",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "knip": "^6.32.2",
    "mockdate": "^3.0.5",
    "oxc-transform-react": "^0.145.0",
    "oxfmt": "0.63.0",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "rollup-plugin-visualizer": "^6.0.5",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "browserslist": [
    ">0.2%",
    "not ie 11",
    "not op_mini all"
  ]
}
