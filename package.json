{
  "name": "osmcha2",
  "version": "2.0.0-alpha.1",
  "bugs": {
    "url": "https://github.com/tordans/osmcha2/issues"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/tordans/osmcha2.git"
  },
  "type": "module",
  "scripts": {
    "type-check": "tsc --noEmit",
    "lint": "oxlint --fix --fix-dangerously --deny-warnings -c oxlint.config.mjs .",
    "lint-check": "oxlint --deny-warnings -c oxlint.config.mjs .",
    "format": "oxfmt --write -c oxfmt.config.mjs .",
    "format-check": "oxfmt --check -c oxfmt.config.mjs .",
    "test-run": "vitest run --passWithNoTests",
    "test-watch": "vitest",
    "coverage": "vitest run --coverage",
    "knip": "KNIP_STRICT=1 knip --config knip.config.mjs",
    "knip-warn": "knip --config knip.config.mjs || true",
    "check": "bun run --parallel type-check lint format test-run knip-warn",
    "check-ci": "bun run --parallel type-check lint-check format-check test-run",
    "check-pre-push": "bun run --parallel type-check lint format test-run knip",
    "prepare": "husky",
    "dev": "vite",
    "build": "vite build",
    "analyze": "ANALYZE=true bun run build",
    "preview": "vite preview",
    "generate-presets": "bun scripts/generate-preset-data.ts"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@fontsource/open-sans": "^5.3.0",
    "@headlessui/react": "^2.2.10",
    "@openstreetmap/id-tagging-schema": "^7.3.0",
    "@osm-editor-kit/maplibre-editor-layer-index": "1.0.0",
    "@osm-editor-kit/street-imagery": "1.0.0",
    "@osm-editor-kit/street-imagery-react": "1.1.0",
    "@osm-traffic-signs/converter": "0.8.0",
    "@osmcha/maplibre-adiff-viewer": "^1.3.1",
    "@osmcha/osm-adiff-parser": "^3.1.0",
    "@phosphor-icons/react": "^2.1.10",
    "@rapideditor/country-coder": "5.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/query-async-storage-persister": "^5.105.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-hotkeys": "0.17.0",
    "@tanstack/react-pacer": "^0.24.1",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-query-devtools": "^5.105.0",
    "@tanstack/react-query-persist-client": "^5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-table": "^9.3.1",
    "@turf/area": "^7.4.0",
    "@turf/bbox": "^7.4.0",
    "@turf/bbox-polygon": "^7.4.0",
    "@turf/simplify": "^7.4.0",
    "bubblesets-js": "3.0.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "idb-keyval": "^6.3.0",
    "linkify-plugin-mention": "^4.4.0",
    "linkify-react": "^4.4.0",
    "linkifyjs": "^4.4.0",
    "mapillary-js": "4.1.2",
    "maplibre-gl": "^6.16.0",
    "motion": "^14.6.0",
    "osm-auth": "^3.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-map-gl": "^8.1.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tag2link": "^2026.10.21",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "terra-draw": "^1.38.0",
    "terra-draw-maplibre-gl-adapter": "^1.5.0",
    "zod": "4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-form-devtools": "^0.2.34",
    "@tanstack/react-hotkeys-devtools": "0.11.1",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/router-plugin": "^1.168.48",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "browserslist": "^4.29.5",
    "browserslist-to-esbuild": "^2.1.1",
    "eslint-plugin-compat": "^7.0.2",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "knip": "^6.44.1",
    "mockdate": "^3.0.5",
    "oxc-transform-react": "^0.156.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "5.1.0"
  },
  "optionalDependencies": {
    "@typescript/typescript-darwin-arm64": "7.0.2",
    "@typescript/typescript-linux-x64": "7.0.2"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not op_mini all",
    "not kaios > 0"
  ],
  "trustedDependencies": [
    "eslint-plugin-compat"
  ]
}
