{
  "name": "osmcha-frontend-v2",
  "version": "1.4.0",
  "bugs": {
    "url": "https://github.com/osmcha/osmcha-frontend/issues"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/osmcha/osmcha-frontend.git"
  },
  "type": "module",
  "scripts": {
    "type-check": "tsc --noEmit",
    "lint": "oxlint --fix --fix-dangerously --deny-warnings -c oxlint.config.mjs .",
    "lint-check": "oxlint --deny-warnings -c oxlint.config.mjs .",
    "format": "oxfmt --write -c oxfmt.config.mjs .",
    "format-check": "oxfmt --check -c oxfmt.config.mjs .",
    "test-run": "vitest run --passWithNoTests",
    "test-watch": "vitest",
    "coverage": "vitest run --coverage",
    "check": "bun run --parallel type-check lint format test-run",
    "check-ci": "bun run --parallel type-check lint-check format-check test-run",
    "build-env": "dotenv -c -- jq -n 'env | with_entries(select(.key | startswith(\"OSMCHA_\")))' > public/env.json",
    "dev": "bun run build-env && vite",
    "build": "bun run build-env && vite build",
    "analyze": "ANALYZE=true bun run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/open-sans": "^5.3.0",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@osmcha/maplibre-adiff-viewer": "^1.3.1",
    "@osmcha/osm-adiff-parser": "^3.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.90.17",
    "@tanstack/react-query-devtools": "^5.91.2",
    "@turf/area": "^7.1.0",
    "@turf/bbox": "^7.1.0",
    "@turf/bbox-polygon": "^7.2.0",
    "@turf/simplify": "^7.1.0",
    "@turf/truncate": "^7.1.0",
    "clsx": "^2.1.1",
    "date-fns": "^2.22.1",
    "deep-equal": "^2.2.3",
    "diff": "^8.0.3",
    "linkify-react": "^4.3.2",
    "linkifyjs": "^4.3.2",
    "lodash.debounce": "^4.0.8",
    "maplibre-gl": "^5.1.0",
    "motion": "^13.1.0",
    "mousetrap": "^1.6.5",
    "react": "^19",
    "react-datepicker": "^4.1.1",
    "react-dom": "^19",
    "react-markdown": "^10.1.0",
    "react-router": "^7.12.0",
    "react-select": "^5.10.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tag2link": "^2025.5.21",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "terra-draw": "^1.1.0",
    "terra-draw-maplibre-gl-adapter": "^1.0.1",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv-cli": "^11.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^27.4.0",
    "mockdate": "^3.0.5",
    "oxfmt": "0.56.0",
    "oxlint": "1.70.0",
    "oxlint-config-react-hooks-js": "^1.1.3",
    "oxlint-tsgolint": "7.0.2001",
    "rollup-plugin-visualizer": "^6.0.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.17"
  },
  "browserslist": [
    ">0.2%",
    "not ie 11",
    "not op_mini all"
  ]
}
