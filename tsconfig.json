{
  // Soft-aligned to the FMC app profile (total-typescript bundler/dom, inlined, no extends).
  // Vite SPA: no server boundary and no scripts/ folder, so one app profile is enough.
  // Not adopted yet: noUncheckedIndexedAccess (50 errors) and noImplicitAny (11 errors) need source changes.
  // Other deviations from examples/tsconfig.app.json:
  //   types: vite/client only — no Bun globals in src/, so no bun-types/web and no @types/bun or bun-types devDependency
  //   paths: omitted — no src file imports through '@/'
  //   allowJs: kept — src/ has three .jsx test files, which TypeScript checks only with allowJs
  //   include: src/** only — vite.config.js and root config files are not type-checked
  //   lib ES2025 lets tsc accept built-ins newer than the browser floor (for example Set.prototype.union); compat/compat in oxlint.config.mjs catches only some of them
  "compilerOptions": {
    "target": "ES2025",
    "useDefineForClassFields": true,
    "lib": ["ES2025", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo-app",
    "noErrorTruncation": true,
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitAny": false,
    "noImplicitOverride": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noUncheckedSideEffectImports": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "types": ["vite/client"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
