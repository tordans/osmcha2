# Copy to .env.local (ignored by git). Local builds post discussion comments only to the
# OSM sandbox: app 1596 of account tordansdev (redirect http://127.0.0.1:5287/osm-oauth),
# https://master.apis.dev.openstreetmap.org/oauth2/applications/1596
# The client id is public (PKCE, no secret).
VITE_OSM_OAUTH_CLIENT_ID=QxgK66DOSv7PsE7Dr6kDeD-6SBgFKs-e_IOe902Rc_M
VITE_OSM_AUTH_URL=https://master.apis.dev.openstreetmap.org
VITE_OSM_API_URL=https://master.apis.dev.openstreetmap.org
# Optional: Mapillary client token for the street-level photo layer and viewer. Without it the
# shared token of account tordans is used (50,000 tile requests a day, shared with Maid).
# VITE_MAPILLARY_TOKEN=
